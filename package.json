{
  "name": "pflege-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Pflege-Dashboard mit KI-Sachbearbeiter – Frontend (Tagwerk). Nur fiktive Demodaten.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "node tools/start.mjs",
    "preview": "npm run build && node tools/start.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "check:bundle": "node tools/check-bundle.mjs",
    "check:source": "node tools/check-source.mjs",
    "check:proxy": "node tools/check-proxy.mjs",
    "check:dev": "node tools/check-dev.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle && npm run check:source && npm run check:proxy && npm run check:dev",
    "shots": "node tools/shots.mjs",
    "shots:randfaelle": "node tools/edge-shots.mjs",
    "shots:echt": "node tools/real-app-shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@openuidev/react-lang": "0.3.1",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@vercel/functions": "3.9.11",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

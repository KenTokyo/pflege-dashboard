{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "ignoreDeprecations": "6.0",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "../types/**/*.ts",
    "tests/*.typecheck.ts",
    "../supabase/functions/_shared/**/*.ts"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "../types/**/*.ts",
    "tests/*.typecheck.ts",
    "runtime/**/*.ts",
    "../api/**/*.ts"
  ]
}

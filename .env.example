# Public client values; never VITE_ admin/database/provider keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional server aliases of the same public project values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PROJECT_REF=ttbfpqveexmlqxkzwlmz
# Server ONLY; protected local .env (0600), Vercel sensitive env in Production/Preview.
DATABASE_URL=
# Preferred OpenCode Go key. DEEPSEEK_API_KEY is its supported legacy variable.
OPENCODE_API_KEY=
DEEPSEEK_API_KEY=
# Google AI Studio Developer API, server only, never VITE_ or a URL parameter.
GEMINI_API_KEY=
# Optional separate existing adapter, never a fallback for DeepSeek.
OPENAI_API_KEY=
# Local Node only. Cloud uses the bundled PUBLIC official CA with full TLS verification.
PGSSLROOTCERT=
PGSSLMODE=verify-full
HOST=127.0.0.1
PORT=5174
# Optional local production preview, absolute project dist path only.
STATIC_DIR=
# Optional exact comma-separated origins. Uncommenting with an empty value denies browser origins.
# ALLOWED_ORIGINS=https://pflege-dashboard-puce.vercel.app
# No service_role/PAT is needed. VERCEL_URL is trusted Vercel deployment metadata.
# No cost cap in env: SQL ledger/reservations record spending; demo setup explicitly configures unlimited spending.

# Öffentliche Vorlage ohne echte Werte. Der lokale Verbindungsstand steht in der Doku.
# Echte Werte nur lokal in .env speichern: gitignored, chmod 600, nie ausgeben.
# Vorhandene .env-Werte erhalten. Anleitung: docs/supabase-provisioning.md

# Frontend: ausschließlich Projekt-URL und öffentlicher Publishable-Key.
# Beide werden später im Browser sichtbar. Niemals Admin-Keys als VITE_* setzen.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend: URL desselben Projekts. Kein VITE_-Präfix für Backend-Werte.
SUPABASE_URL=

# Nur bei einem freigegebenen Backend-Bedarf befüllen.
# Secret-Key bevorzugt; Service-Role-Key nur als bestätigte kompatible Alternative.
# Nicht beide vorsorglich auslesen. Grenzen mit Backend-Vertrag v0.1 abgeglichen.
# Serverseitige Env-Leser und Edge Functions sind in Phase 0 noch nicht gebaut.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Projektverwaltung: reale Projektkennung nach Anlage prüfen, nicht erfinden.
PROJECT_REF=

# Nur für später freigegebene Datenbankverwaltung/Migrationen, niemals Frontend.
# DATABASE_URL enthält gegebenenfalls das Passwort und ist vollständig geheim.
# Verbindung aus Connect übernehmen; verschlüsselt und zum geprüften Zielprojekt.
DATABASE_URL=

# Für lokale Datenbankwerkzeuge: offizielles Supabase-CA-Zertifikat.
# Bezug: https://supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt
# PGSSLROOTCERT lokal auf den vollständigen Pfad zur Zertifikatsdatei setzen.
PGSSLROOTCERT=
PGSSLMODE=verify-full

# Separates Datenbankpasswort, falls der freigegebene CLI-Weg es benötigt.
# Nicht mit dem Supabase-Login oder einem Demo-Login verwechseln.
SUPABASE_DB_PASSWORD=

# Optional: erst für später freigegebene CLI-Projektverwaltung nötig.
# Kein Token erzeugen/auslesen, solange dieser Weg nicht benötigt wird.
SUPABASE_ACCESS_TOKEN=

# Keine AI-Providerkeys in dieser Vorlage oder im Frontend.
# Später ausschließlich geschützte Edge-Function-Secrets, eigener Auftrag nötig.
